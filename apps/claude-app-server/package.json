  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^25.7.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
